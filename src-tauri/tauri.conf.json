{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isle",
  "version": "1.7.1",
  "identifier": "com.isle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Isle",
        "width": 600,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "backgroundColor": "#00000000",
        "backgroundThrottling": "disabled"
      },
      {
        "label": "settings",
        "title": "Isle",
        "width": 900,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false,
        "url": "settings-idle.html",
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQjI3ODQwMzUzQ0VGODAKUldTQTd6dzFRSGl5SUI3NUNjRmRsRnNHYU5WR0tkZDlKVGUvTWJ3cS9oU0RHZC9oS2sxTFpWMWoK",
      "endpoints": [
        "https://github.com/k0valyk/isle/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "targets": [
      "nsis",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A live island for Windows",
    "longDescription": "Isle is a free, local-first dynamic island for Windows: media, clipboard, screenshots with OCR, notes, calendar, timer, weather, AI chat, phone notifications, agent hooks and a terminal in one place.",
    "publisher": "Isle contributors"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions used by the Isle island and settings windows.",
  "windows": ["main", "settings", "capture-view"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:event:default",
    "core:app:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "dialog:default"
  ]
}
